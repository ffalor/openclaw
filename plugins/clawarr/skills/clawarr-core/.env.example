# ~/.openclaw/.env — written by scripts/setup.sh. Non-secret values and http-only keys live here;
# keys for https services live in the OpenClaw secret store instead (never in both places).

# Per-service base URLs
SONARR_URL=https://sonarr.example.ts.net
RADARR_URL=http://192.168.1.100:7878
# LIDARR_URL=  READARR_URL=  PROWLARR_URL=  BAZARR_URL=  OVERSEERR_URL=
# TAUTULLI_URL=  SABNZBD_URL=  NOTIFIARR_URL=  MAINTAINERR_URL=  PLEX_URL=

# Plaintext keys only for http:// services (the egress proxy cannot protect plain HTTP)
RADARR_API_KEY=

# Optional fallback for services without a <SERVICE>_URL: ${CLAWARR_SCHEME:-http}://$CLAWARR_HOST:<port>
# CLAWARR_HOST=192.168.1.100
# CLAWARR_SCHEME=http
# SONARR_PORT=8989  RADARR_PORT=7878  READARR_PORT=8787  PROWLARR_PORT=9696
# OVERSEERR_PORT=5055  SABNZBD_PORT=8081  TAUTULLI_PORT=8181  PLEX_PORT=32400
